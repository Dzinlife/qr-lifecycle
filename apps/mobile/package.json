{
  "name": "@qr-lifecycle/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "build": "expo export --platform ios --output-dir dist",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "native:generate": "expo prebuild",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts src/scanner/*.test.ts plugins/*.test.cjs"
  },
  "dependencies": {
    "@qr-lifecycle/contracts": "workspace:*",
    "expo": "~57.0.9",
    "expo-application": "~57.0.2",
    "expo-dev-client": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-image-picker": "~57.0.7",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.2",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
